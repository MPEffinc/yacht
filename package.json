{
  "name": "yacht-dice-online",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Server-authoritative multiplayer lobby foundation for Yacht Dice Online.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "dev": "vite --host 0.0.0.0",
    "start": "node dist/server/src/server.js",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/jura": "^5.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.0",
    "typescript": "5.8.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
